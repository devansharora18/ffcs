# OpenCode inference (server-side only, never expose to the client)
OPENCODE_API_KEY=oc_sk_...
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=deepseek-v4.1-flash

# Ads. Leave unset to show the house ad for the slot itself.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=
NEXT_PUBLIC_SPONSOR_CONTACT=

# Optional: point the skill download at your own fork
# NEXT_PUBLIC_GITHUB_REPO=devansharora18/ffcs
# NEXT_PUBLIC_GITHUB_BRANCH=main
